# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Matches rustfmt.toml: 4-space indent, 72-column lines.
[*.rs]
indent_size = 4
max_line_length = 72

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

# Generated pages and fixtures keep their bytes as written.
[{docs/*.html,quotes/*,examples/*.html}]
trim_trailing_whitespace = false
insert_final_newline = unset
